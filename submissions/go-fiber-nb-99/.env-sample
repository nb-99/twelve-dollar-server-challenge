# Copy to .env (git-ignored) and adjust; .envrc loads it through direnv.
# Every Makefile variable can be set here, e.g. MODE or BENCH_MAX_VUS.

# MODE=k8s: image repository prefix to push to.
K8S_REGISTRY=registry.example.com/owner
# MODE=k8s: existing namespace, and an optional image pull secret in it.
K8S_NAMESPACE=twelve-dollar-challenge
K8S_PULL_SECRET=
# MODE=k8s benchmark: number of k6 pods (default 3), each pod's CPU request,
# CPU limit, and memory (defaults 500m, 6, and 10Gi), the node that runs the app
# and k6 pods, or the node that runs only the app.
K8S_K6_PODS=
K8S_K6_CPU_REQUEST=
K8S_K6_CPU=
K8S_K6_MEMORY=
K8S_NODE=
K8S_APP_NODE=
